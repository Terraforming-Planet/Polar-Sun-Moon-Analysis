{
  "tasks": [
    {
      "id": "global-safety-feed",
      "command": [
        "python",
        "scripts/build_global_safety_feed.py"
      ],
      "output_path": "web/public/data/hazards.json"
    },
    {
      "id": "copernicus-frame-manifest",
      "command": [
        "bash",
        "-lc",
        "python copernicus_pipeline/build_frame_manifest.py --bbox ${TP_BBOX:-14 49 24 55} --start $(date -u -d '2 days ago' +%Y-%m-%dT%H:%M:%SZ) --end $(date -u +%Y-%m-%dT%H:%M:%SZ) --limit ${TP_FRAME_LIMIT:-100} && bash scripts/publish_copernicus_manifest.sh"
      ],
      "output_path": "web/public/data/copernicus/latest.json"
    }
  ]
}
